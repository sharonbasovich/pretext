# Required for live calls. Get one at https://www.assemblyai.com — the Voice
# Agent API bills on WebSocket-open time (~$0.075/min); the free tier is $50.
ASSEMBLYAI_API_KEY=

# Optional demo cost controls -------------------------------------------------
# Hard cap on session length (server enforces 60..10800). Pretext clamps this
# to <=240s regardless of what you set here.
PRETEXT_MAX_SESSION_SECONDS=240

# Max voice sessions minted per UTC day across the whole deployment.
PRETEXT_DAILY_SESSION_CAP=200

# If set, the browser must supply this passcode before a token is minted.
PRETEXT_DEMO_PASSCODE=

# Set to "1" to run the bundled mock agent instead of AssemblyAI (offline dev).
PRETEXT_MOCK=0

# Mock agent WebSocket URL used by the browser when PRETEXT_MOCK=1.
PRETEXT_MOCK_WS_URL=ws://localhost:8787/v1/ws

# Set to "1" to let /api/agent-config serve the INLINE persona config when no
# stored agent exists (agents.lock.json). Default is 503 stored_agent_required
# because inline config exposes the full attacker playbook to the browser.
# Debug/local use only — never on a public deployment.
PRETEXT_EXPOSE_INLINE=0
